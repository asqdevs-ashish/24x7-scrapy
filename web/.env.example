# Neon → Dashboard → Connection Details.
# Pooled URL (host has "-pooler"). Used by Next.js at runtime on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct URL (no "-pooler"). Used by `prisma migrate` during the Vercel build.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Login for the dashboard. All three are required – the app refuses to serve
# anything (fails closed) if one is missing.
DASHBOARD_USER="admin"
DASHBOARD_PASSWORD="change-me-to-a-long-random-string"
# Signs session cookies. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-32+-random-characters-xxxxxxxxxxxx"

# Instant worker runs for "Run first" jobs (optional – without them, priority
# jobs still jump the queue but wait for the next scheduled run).
# Fine-grained PAT → Repository access: this repo only → Permissions: Actions = Read and write.
GITHUB_PAT=""
GITHUB_REPO="your-user/your-repo"
# GITHUB_WORKFLOW="scraper.yml"
# GITHUB_REF="main"
