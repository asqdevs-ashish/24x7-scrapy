# Local test runs only (`npm run dev`). In GitHub Actions these come from repo secrets/vars.
# Use the DIRECT (unpooled) Neon URL: the worker is one long-lived process.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Optional tuning (defaults shown)
MAX_JOBS_PER_RUN=1
RUN_BUDGET_MINUTES=150
STALE_JOB_MINUTES=200
MAX_JOB_ATTEMPTS=3
# Re-read the job (Pause button, waiting priority jobs) every N places read / every N seconds
HEARTBEAT_EVERY=20
HEARTBEAT_MAX_SECONDS=90
# Safety cap per search; Google Maps itself ends most lists at ~120 places
MAX_FEED_CARDS=500
# Scroll step: wait this long for new cards; give up after this many empty steps
FEED_GROWTH_TIMEOUT_MS=8000
MAX_FEED_STALLS=4
# Comma-separated; a lead's address must contain one of these (empty = no check)
ADDRESS_MUST_CONTAIN=Karnataka,Karnātaka
# Set to "false" to watch the browser locally
HEADLESS=true
